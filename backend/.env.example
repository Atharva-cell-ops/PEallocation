# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace 'YOUR_PASSWORD' with your actual local PostgreSQL postgres password
DATABASE_URL="postgresql://postgres:123456@localhost:5432/pe_allocation_db?schema=public"

# PostgreSQL Direct Connection Details (Optional / pg pool)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_password_here
PGDATABASE=pe_allocation_db

# Authentication Secrets (Replace with high-entropy random strings for production)
JWT_SECRET="dev_jwt_secret_key_8f7b2c9d4e1a0b3f5c7d9e2a4b6c8d0e"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CLIENT_URL="http://localhost:5173"
